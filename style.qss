/* bilibili-m4s-merger — global stylesheet (light theme, dashboard-inspired) */

* {
    font-family: "Segoe UI Variable", "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
    color: #111827;
    outline: none;
}

QMainWindow, QDialog {
    background-color: #F7F8FA;
}

QWidget#centralWidget {
    background-color: #F7F8FA;
}

QLabel {
    background: transparent;
    font-size: 13px;
    color: #374151;
}

QLabel#appTitle {
    font-size: 22px;
    font-weight: 700;
    color: #111827;
    padding: 0;
}

QLabel#appSubtitle {
    font-size: 13px;
    color: #6B7280;
    padding: 0;
}

QLabel#pathLabel {
    color: #6B7280;
    font-size: 13px;
}

QLabel#sectionLabel {
    color: #6B7280;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

QLabel#statusBar {
    color: #6B7280;
    font-size: 12px;
    padding: 6px 4px;
}

/* ===== Buttons ===== */
QPushButton {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 13px;
    color: #111827;
    min-height: 18px;
}

QPushButton:hover {
    background-color: #F9FAFB;
    border-color: #D1D5DB;
}

QPushButton:pressed {
    background-color: #F3F4F6;
}

QPushButton:disabled {
    color: #9CA3AF;
    background-color: #F9FAFB;
    border-color: #F3F4F6;
}

QPushButton#primary {
    background-color: #2563EB;
    color: #FFFFFF;
    border: 1px solid #2563EB;
    font-weight: 600;
    padding: 10px 24px;
    min-height: 22px;
}

QPushButton#primary:hover {
    background-color: #1D4ED8;
    border-color: #1D4ED8;
}

QPushButton#primary:pressed {
    background-color: #1E40AF;
    border-color: #1E40AF;
}

QPushButton#primary:disabled {
    background-color: #93C5FD;
    border-color: #93C5FD;
    color: #FFFFFF;
}

/* ===== Checkbox ===== */
QCheckBox {
    spacing: 8px;
    font-size: 13px;
    color: #374151;
    background: transparent;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1.5px solid #D1D5DB;
    border-radius: 5px;
    background: #FFFFFF;
}

QCheckBox::indicator:hover {
    border-color: #9CA3AF;
}

QCheckBox::indicator:checked {
    background: #2563EB;
    border-color: #2563EB;
    image: url(assets/check.svg);
}

QCheckBox::indicator:disabled {
    background: #F3F4F6;
    border-color: #E5E7EB;
}

/* ===== Radio button ===== */
QRadioButton {
    spacing: 8px;
    font-size: 13px;
    color: #374151;
    background: transparent;
    padding: 4px 2px;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1.5px solid #D1D5DB;
    border-radius: 9px;
    background: #FFFFFF;
}

QRadioButton::indicator:hover {
    border-color: #9CA3AF;
}

QRadioButton::indicator:checked {
    background: #2563EB;
    border-color: #2563EB;
    image: url(assets/radio_dot.svg);
}

QRadioButton:hover {
    color: #111827;
}

/* ===== Text edit (log) ===== */
QTextEdit {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 10px;
    padding: 10px 12px;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 12px;
    color: #374151;
    selection-background-color: #DBEAFE;
    selection-color: #1E3A8A;
}

/* ===== Progress bar ===== */
QProgressBar {
    background-color: #F3F4F6;
    border: none;
    border-radius: 5px;
    max-height: 10px;
    min-height: 10px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    background-color: #2563EB;
    border-radius: 5px;
}

/* ===== Scroll area ===== */
QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 4px 2px 4px 0;
}

QScrollBar::handle:vertical {
    background: #D1D5DB;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #9CA3AF;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
    height: 0;
    border: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0 4px 2px 4px;
}

QScrollBar::handle:horizontal {
    background: #D1D5DB;
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #9CA3AF;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
    width: 0;
    border: none;
}

/* ===== Group "card" ===== */
GroupWidget {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 12px;
}

QLabel#groupTitle {
    font-size: 14px;
    font-weight: 600;
    color: #111827;
}

QLabel#groupTitleIncomplete {
    font-size: 14px;
    font-weight: 600;
    color: #B91C1C;
}

QLabel#streamSectionLabel {
    font-size: 11px;
    font-weight: 600;
    color: #6B7280;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    padding-top: 4px;
}

/* ===== Filename edit ===== */
QLineEdit#filenameEdit {
    background-color: #F9FAFB;
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    padding: 7px 10px;
    font-size: 13px;
    color: #111827;
    selection-background-color: #DBEAFE;
    selection-color: #1E3A8A;
}

QLineEdit#filenameEdit:focus {
    background-color: #FFFFFF;
    border-color: #2563EB;
}

QLineEdit#filenameEdit:disabled {
    background-color: #F3F4F6;
    color: #9CA3AF;
}

QLabel#filenameSuffix {
    color: #6B7280;
    font-size: 13px;
    padding: 0 4px;
}

/* ===== Status pill ===== */
QLabel#pillReady {
    background-color: #DCFCE7;
    color: #166534;
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 600;
}

QLabel#pillMissing {
    background-color: #FEE2E2;
    color: #B91C1C;
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 600;
}

QLabel#pillWarning {
    background-color: #FEF3C7;
    color: #92400E;
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 600;
}

/* ===== Message boxes ===== */
QMessageBox {
    background-color: #FFFFFF;
}

QMessageBox QLabel {
    color: #111827;
    font-size: 13px;
}
